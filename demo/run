#!/usr/bin/env bash
# Runs one of the demo's large runs from an empty store and keeps its output in fork/build.
#
#   demo/run gate|kills|wide [--tmpfs] [libch-demo flags]
#
#   gate   1,000 tenants take 100,000 batches of 1,000 rows at 100,000 events a second, and 100 of them are
#          queried through fleets of four servers.
#   kills  The gate's load with a kill timer on one insert in ten: a worker that has yet to answer when its
#          timer runs out is killed, and its batch goes again.
#   wide   10,000 tenants take 20,000 batches of 1,000 rows at 20,000 events a second.
#
# The script wipes libch's dev stack before the run and after it, so run nothing else of libch beside it: the
# run leaves its tenants, whose removal would take longer than the run. With --tmpfs the InodeDB store lives in
# /dev/shm for the run.
# Flags after these go to `libch-demo` and override the run's own. LIBCH_FORK=1 and LIBCH_SANDBOX=1 apply as they
# do to any run.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
usage="usage: demo/run gate|kills|wide [--tmpfs] [libch-demo flags]"
name=${1:?$usage}
shift
case $name in
    gate) flags=(--tenants 1000 --batches 100000 --events-per-second 100000 --queried-tenants 100 --fleet-servers 4 --checked-tenants 100 --setups 12 --compactions 8 --leave-tenants) ;;
    kills) flags=(--tenants 1000 --batches 100000 --events-per-second 100000 --queried-tenants 20 --fleet-servers 4 --checked-tenants 100 --setups 12 --compactions 8 --leave-tenants --kill-one-in 10 --free-queue-wait 1800) ;;
    wide) flags=(--tenants 10000 --batches 20000 --events-per-second 20000 --queried-tenants 20 --fleet-servers 4 --checked-tenants 100 --setups 12 --compactions 8 --leave-tenants) ;;
    *) echo "$usage" >&2; exit 2 ;;
esac

store=
if [ "${1:-}" = "--tmpfs" ]; then
    store=/dev/shm/libch-inodedb
    name=${name}_tmpfs
    shift
fi

cd "$root"
scripts/dev-down --wipe
if [ -n "$store" ]; then
    export LIBCH_INODEDB_DIR=$store LIBCH_INODEDB_ADMIN_KEY_FILE=$store/admin.key
fi
trap 'scripts/dev-down --wipe; unset LIBCH_INODEDB_DIR LIBCH_INODEDB_ADMIN_KEY_FILE; scripts/dev-up > /dev/null' EXIT
scripts/dev-up

log=$root/fork/build/demo_$name.log
mkdir -p "$(dirname "$log")"
status=0
cargo run --release -p libch-demo -- "${flags[@]}" "$@" > "$log" 2>&1 || status=$?
tail -n 16 "$log"
echo "log: $log"
exit $status
