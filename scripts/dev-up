#!/usr/bin/env bash
# Starts libch's own dev stack, with its state in .dev/ (or $LIBCH_DEV_DIR):
#   s3proxy  127.0.0.1:11211, bucket `libch`, credentials libch/libch;
#   InodeDB  127.0.0.1:7170, on SQLite, with its admin key in .dev/inodedb/admin.key.
# $LIBCH_INODEDB_DIR moves the store and its key elsewhere, as onto tmpfs; tests then find the key through
# LIBCH_INODEDB_ADMIN_KEY_FILE.
# $LIBCH_INODEDB_BIN names an InodeDB server to run in place of the one built in BigHouse's submodule.
# The ports differ from BigHouse's own dev stack, so both run side by side.
# `scripts/dev-down` stops both; `scripts/dev-down --wipe` also deletes their state.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
bighouse=${BIGHOUSE_DIR:-$root/../BigHouse}
dev=${LIBCH_DEV_DIR:-$root/.dev}
store=${LIBCH_INODEDB_DIR:-$dev/inodedb}
inodedb=${LIBCH_INODEDB_BIN:-$bighouse/inodedb/target/release/inodedb}
inodedb_port=${LIBCH_INODEDB_PORT:-7170}
s3_port=${LIBCH_S3_PORT:-11211}

if [ ! -x "$inodedb" ]; then
    echo "no InodeDB server at $inodedb; build it with $bighouse/scripts/inodedb-build" >&2
    exit 1
fi
mkdir -p "$dev/s3/libch" "$store"

if ! docker ps --format '{{.Names}}' | grep -qx libch-s3proxy; then
    docker rm -f libch-s3proxy > /dev/null 2>&1 || true
    docker run -d --name libch-s3proxy -p "127.0.0.1:$s3_port:80" \
        -e S3PROXY_ENDPOINT=http://0.0.0.0:80 \
        -e S3PROXY_AUTHORIZATION=aws-v2-or-v4 \
        -e S3PROXY_IDENTITY=libch \
        -e S3PROXY_CREDENTIAL=libch \
        -e JCLOUDS_PROVIDER=filesystem \
        -e JCLOUDS_FILESYSTEM_BASEDIR=/data \
        -v "$dev/s3:/data" \
        andrewgaul/s3proxy:4.1.1 > /dev/null
fi

if [ ! -f "$store/pid" ] || ! kill -0 "$(cat "$store/pid")" 2> /dev/null; then
    cat > "$store/inodedb.toml" <<TOML
listen = "127.0.0.1:$inodedb_port"
shallow_idle = false

[storage]
backend = "sqlite"
path = "$store/db.sqlite"
TOML
    nohup "$inodedb" --config "$store/inodedb.toml" --init-key "$store/admin.key" \
        >> "$store/server.log" 2>&1 &
    echo $! > "$store/pid"
fi

for _ in $(seq 300); do
    if [ -s "$store/admin.key" ] && (exec 3<> "/dev/tcp/127.0.0.1/$inodedb_port") 2> /dev/null \
        && curl -s -o /dev/null "http://127.0.0.1:$s3_port/"; then
        echo "s3proxy: http://127.0.0.1:$s3_port/libch   InodeDB: 127.0.0.1:$inodedb_port (key: $store/admin.key)"
        exit 0
    fi
    sleep 0.1
done
echo "the stack did not come up; see $store/server.log and 'docker logs libch-s3proxy'" >&2
exit 1
